# Copy this file to .env and fill in your own keys. Never use VITE_ for secrets.
# The server loads this file by absolute path, so it does not matter what the
# working directory is when it starts. Override with DOTENV_CONFIG_PATH.
OPENAI_API_KEY=
CEREBRAS_API_KEY=
# Audio model for speaking feedback. There is no cloud transcription any more:
# recognition is always local Whisper.
OPENAI_AUDIO_MODEL=gpt-audio
CEREBRAS_MODEL=qwen-3.8-27b
# Set to omit if your chosen Cerebras model does not accept reasoning_effort.
CEREBRAS_REASONING_EFFORT=none
PORT=3000
# Where history markdown, the Python environment and downloaded models live.
# A dev checkout defaults to the repository root; a packaged build should be given
# ~/.local/share/just-speak by the shell that launches the server.
# JUST_SPEAK_DATA_DIR=
# Optional local Whisper tuning.
# LOCAL_WHISPER_THREADS=6
# LOCAL_WHISPER_PYTHON=/absolute/path/to/.venv/bin/python
# LOCAL_MODELS_DIR=/absolute/path/to/models
